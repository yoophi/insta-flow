{
  "manifest_version": 3,
  "name": "Insta Flow",
  "version": "0.4.3",
  "description": "사진과 영상을 원본 비율로 최대 크기로 표시하고 댓글을 숨깁니다.",
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "css": [
        "insta-flow.css"
      ],
      "js": [
        "catalog.js",
        "content.js"
      ]
    }
  ],
  "short_name": "Insta Flow",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
